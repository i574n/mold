open sm'_operators

inl main () =
    {
        tests = true
        trace = false
        backends =
            [
                Gleam, false
                Lua, true
                Fsharp, true
                Cuda, false
                Cpp, true
                Rust None, false
                Rust (Wasm |> Some), false
                Rust (Contract |> Some), false
                TypeScript, false
                Python, false
            ]
            |> listm'.filter snd
            |> listm.map (fst >> reflection.union_to_string)
            |> listm'.box
            |> listm'.to_array'
    }
    |> sm'.format
    |> console.write_line
